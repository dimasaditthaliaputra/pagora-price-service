# Wajib, minimal 32 karakter. Buat dengan: openssl rand -hex 32
# Nilai yang sama dipasang di Laravel sebagai PRICE_SERVICE_API_KEY.
API_KEY=

# Domain publik untuk HTTPS otomatis (Caddy). Arahkan DNS A record ke IP VPS.
DOMAIN=

BI_BASE_URL=https://www.bi.go.id/hargapangan
BI_TIMEOUT_SECONDS=90
# 1 = Pasar Tradisional, 2 = Pasar Modern, 3 = Pedagang Besar, 4 = Produsen
BI_PRICE_TYPE_ID=1
MAX_RANGE_DAYS=400
MIN_FORECAST_POINTS=10
MAX_HORIZON_DAYS=90
